DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Option 1: Render provides DATABASE_URL automatically when linked to a database
# Option 2: Provide individual PostgreSQL connection params
DATABASE_URL=postgresql://user:password@host:5432/cdo
DB_ENGINE=postgresql
DB_NAME=cdo
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://cdo-frontend.onrender.io,https://cdo-backend.onrender.io,http://localhost:5173,http://localhost:3000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-app-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-app-email@gmail.com

FRONTEND_URL=https://cdo-frontend.onrender.io

# Production security
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True
